<?xml version="1.0"?>
<ruleset name="RC Geo Access">
    <description>WordPress coding standards for the current plugin source.</description>
    <file>trunk</file>
    <exclude-pattern>*/tags/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="rc-geo-access"/>
            </property>
        </properties>
    </rule>
</ruleset>
